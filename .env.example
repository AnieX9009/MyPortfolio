# Firebase Firestore Configuration for Sandip's Portfolio
# You can set these in your .env.local file or in your hosting provider (Vercel / Netlify)
# You can also enter them directly in the Admin Panel -> Database tab!

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-portfolio-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-portfolio-app
VITE_FIREBASE_STORAGE_BUCKET=your-portfolio-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
